# Copy to .env for local runs. NEVER commit .env — it is gitignored.
# In production these come from GitHub Secrets, not from a file.

# --- Postgres (Neon) -------------------------------------------------
# Neon dashboard -> your project -> Connection string -> psycopg2
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- LLM provider ----------------------------------------------------
# groq | gemini
LLM_PROVIDER=groq

# console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# aistudio.google.com -> Get API key   (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Telegram --------------------------------------------------------
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# One channel per route (see routing.channels in config/profile.yaml).
# Public channel: @your_channel_name   Private channel: -100xxxxxxxxxx
TELEGRAM_CHANNEL_INDIA=@your_india_channel
TELEGRAM_CHANNEL_INTERNATIONAL=@your_intl_channel

# Fallback used by any route whose own variable above is unset, and the default
# target for failure alerts. Keeps a single-channel setup working unchanged.
TELEGRAM_CHANNEL_ID=@your_channel

# Optional: separate channel for pipeline failures
TELEGRAM_ALERT_CHANNEL_ID=

# --- Tuning ----------------------------------------------------------
# Max jobs sent to the LLM per run (protects free-tier daily quotas)
ENRICH_LIMIT=250
# Max jobs published per run (protects Telegram rate limits)
PUBLISH_LIMIT=60
# Jobs bundled into a single Telegram message
PUBLISH_BATCH_SIZE=5
